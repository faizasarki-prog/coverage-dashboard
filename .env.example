# SARMAAN II Coverage Dashboard — environment template
# Copy this file to `.env` (gitignored) and fill in real values.
# NEVER put real credentials in .env.example.

# --- Core auth ---
# Required, must be >= 32 bytes. Generate a strong value for production, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-string
SUPER_ADMIN_EMAIL=admin
SUPER_ADMIN_PASSWORD=change-me
DATABASE_URL=sqlite:///./admin.db
ALLOWED_ORIGINS=
ENABLE_DOCS=false

# --- Kobo Toolbox API ---
# One account-wide token (Settings > API in kobo.humanitarianresponse.org)
# applies to ALL projects that fetch from Kobo: Sokoto Coverage, Coverage Test,
# Adamawa Coverage. Per-project export URLs are stored in the projects table and
# can also be set from the Admin panel.
KOBO_API_TOKEN=
# Default export URL (used when a project has no URL configured). Current value
# points at the Sokoto Coverage asset.
KOBO_DATA_URL=https://kf.kobotoolbox.org/api/v2/assets/aC7agtm3my3Rfq4m4kYaF7/export-settings/esq4pbxk8MMWxBoGSPq5yMu/data.xlsx
KOBO_REFRESH_MINUTES=60
